{
  "name": "AudioMoth-Live",
  "version": "1.1.4",
  "description": "An Electron-based application for recording and analysing live audio from high sample rate microphones, including the AudioMoth USB Microphone.",
  "main": "main.js",
  "scripts": {
    "postinstall": "install-app-deps && node scripts/install-electron-binary.js",
    "start": "electron .",
    "dist": "node builder.js",
    "install-electron-binary": "node scripts/install-electron-binary.js"
  },
  "author": "openacousticdevices.info <theteam@openacousticdevices.info>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenAcousticDevices/AudioMoth-Live-App.git"
  },
  "build": {
    "extraResources": [
      "./simulator/"
    ],
    "asar": {
      "smartUnpack": true
    },
    "appId": "info.openacousticdevices.audiomothliveapp",
    "mac": {
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.inherit.plist",
      "target": "dmg"
    },
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150
        },
        {
          "x": 430,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "AudioMothLiveAppSetup${version}.dmg"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AudioMothLiveAppSetup${version}.exe",
      "shortcutName": "AudioMoth Live App",
      "uninstallDisplayName": "AudioMoth Live App ${version}"
    },
    "linux": {
      "icon": "build/",
      "category": "Utility",
      "artifactName": "AudioMothLiveAppSetup${version}.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "globals": "^17.7.0"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@popperjs/core": "^2.11.8",
    "audiomoth-usb-microphone-cmd": "file:audiomoth-usb-microphone-cmd",
    "backstage": "file:backstage",
    "bootstrap": "^5.3.8",
    "electron-debug": "4.1.0",
    "jquery": "^4.0.0",
    "jspdf": "^4.2.1"
  },
  "engines": {
    "node": ">=26.1.0"
  }
}
